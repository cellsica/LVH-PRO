# =============================================================================
# Doxyfile — LVH-PRO Documentation Configuration
# Generated for Doxygen 1.16.x
# Run: doxygen Doxyfile  (from project root)
# Output: docs/html/index.html
# =============================================================================

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "LVH-PRO"
PROJECT_NUMBER         = 0.9.0
PROJECT_BRIEF          = "Live Visual Hub — JUCE-based audio plugin host with visualizer SDK"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
FULL_PATH_NAMES        = NO

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = Source
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp
EXCLUDE_PATTERNS       = */JuceLibraryCode/* \
                         */juce_*

#---------------------------------------------------------------------------
# Source / extraction
#---------------------------------------------------------------------------
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
BUILTIN_STL_SUPPORT    = YES
INHERIT_DOCS           = YES

#---------------------------------------------------------------------------
# HTML output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250
DISABLE_INDEX          = NO
HTML_DYNAMIC_SECTIONS  = YES

#---------------------------------------------------------------------------
# Other formats (disabled)
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

#---------------------------------------------------------------------------
# Diagrams (requires Graphviz — disable if not installed)
#---------------------------------------------------------------------------
HAVE_DOT               = NO
CLASS_GRAPH            = YES

#---------------------------------------------------------------------------
# Preprocessor
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
PREDEFINED             = JUCE_WINDOWS=1

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_LOGFILE           =
